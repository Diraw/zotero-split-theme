{
  "name": "zotero-split-theme",
  "type": "module",
  "version": "0.1.1",
  "description": "Split light and dark themes between Zotero UI areas and the PDF reader.",
  "config": {
    "addonName": "Zotero Split Theme",
    "addonID": "zotero-split-theme@diraw.github.io",
    "addonRef": "zoterosplittheme",
    "addonInstance": "ZoteroSplitTheme",
    "prefsPrefix": "extensions.zotero.zoterosplittheme"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diraw/zotero-split-theme.git"
  },
  "author": "craft",
  "bugs": {
    "url": "https://github.com/Diraw/zotero-split-theme/issues"
  },
  "homepage": "https://github.com/Diraw/zotero-split-theme#readme",
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "start": "zotero-plugin serve",
    "build": "zotero-plugin build && tsc --noEmit",
    "lint:check": "prettier --check . && eslint .",
    "lint:fix": "prettier --write . && eslint . --fix",
    "release": "zotero-plugin release",
    "test": "zotero-plugin test",
    "update-deps": "npm update --save"
  },
  "dependencies": {
    "zotero-plugin-toolkit": "^5.1.2"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.5.0",
    "@zotero-plugin/eslint-config": "^0.6.9",
    "chai": "^6.2.2",
    "eslint": "^9.39.4",
    "mocha": "^11.7.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "zotero-plugin-scaffold": "^0.8.5",
    "zotero-types": "^4.1.2"
  },
  "prettier": {
    "printWidth": 80,
    "tabWidth": 2,
    "endOfLine": "lf",
    "overrides": [
      {
        "files": [
          "*.xhtml"
        ],
        "options": {
          "htmlWhitespaceSensitivity": "css"
        }
      }
    ]
  }
}
